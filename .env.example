# Copy to `.env` (which is git-ignored) and fill in real values. Never commit `.env`.

# Database password used by both the postgres container and the backend.
POSTGRES_PASSWORD=change-me

# Secret that signs login tokens. 32+ characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=

# Browser origins allowed to call the API (comma separated).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# URL the browser uses to reach the backend (baked into the front-end at build time).
REACT_APP_API_URL=http://localhost:8080
